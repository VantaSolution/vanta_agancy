# ═══════════════════════════════════════════════════════════
# VANTA Agency — Backend Environment Variables
# ═══════════════════════════════════════════════════════════

PORT=5000
NODE_ENV=production

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agency_v2_db
DB_USER=postgres_user
DB_PASSWORD=your_secure_db_password

# JWT Security Secrets (Must be at least 16 characters)
JWT_SECRET=your_long_random_jwt_access_secret_min_16_chars
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=your_long_random_jwt_refresh_secret_min_16_chars
JWT_REFRESH_EXPIRES_IN=7d

# Allowed CORS Origins (Comma-separated for multiple origins)
CORS_ORIGIN=https://yourdomain.com

# Initial Admin Seed Credentials (Used during npm run seed)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=your_strong_admin_password
