# ═══════════════════════════════════════════════════════════
# VANTA Agency — Git Ignore Rules
# ═══════════════════════════════════════════════════════════

# Dependencies
node_modules/
.pnpm-store/
package-lock.json

# Build outputs & Vercel
dist/
build/
.vite/
.vercel/

# Environment files & Secrets
.env
.env.*
!.env.example

# Logs & Storage
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
uploads/*
!uploads/.gitkeep

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo

# OS System files
.DS_Store
Thumbs.db

# Gemini / Agent System Files
.gemini/
scratch/

# Testing & Coverage
coverage/
.nyc_output/
