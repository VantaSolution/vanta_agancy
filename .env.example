# ═══════════════════════════════════════════════════════════
# VANTA Agency — Root Environment Example
# ═══════════════════════════════════════════════════════════

# Copy to .env or configure in host platform dashboard
NODE_ENV=production
PORT=5000

# PostgreSQL / Supabase Database Connection
DATABASE_URL=postgresql://postgres.your-ref:[YOUR-PASSWORD]@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.your-ref:[YOUR-PASSWORD]@aws-0-region.pooler.supabase.com:5432/postgres

# Alternatively, explicit connection params:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agency_v2_db
DB_USER=postgres_user
DB_PASSWORD=your_secure_db_password

# Authentication Secrets
JWT_SECRET=your_long_random_jwt_access_secret_min_16_chars
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=your_long_random_jwt_refresh_secret_min_16_chars
JWT_REFRESH_EXPIRES_IN=7d
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=your_strong_admin_password

# CORS Settings
CORS_ORIGIN=https://vanta-agency-frontend.vercel.app

# Supabase Storage Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_STORAGE_BUCKET=vanta-media

# Frontend Environment Variables (prefix with VITE_)
VITE_API_URL=https://vanta-agency-backend.vercel.app/api
VITE_USE_MOCK=false
