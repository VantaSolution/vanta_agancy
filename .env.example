# ═══════════════════════════════════════════════════════════
# VANTA Agency — Root Environment Example
# ═══════════════════════════════════════════════════════════

# Copy this file to .env or configure in host platform dashboard
NODE_ENV=production
PORT=5000

# Backend CORS & Database Configuration
CORS_ORIGIN=https://yourdomain.com
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agency_v2_db
DB_USER=postgres_user
DB_PASSWORD=your_secure_db_password

# Authentication Secrets
JWT_SECRET=your_long_random_jwt_access_secret_min_16_chars
JWT_REFRESH_SECRET=your_long_random_jwt_refresh_secret_min_16_chars
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=your_strong_admin_password
