# ═══════════════════════════════════════════════════════════
# VANTA Agency — Frontend Environment Variables
# ═══════════════════════════════════════════════════════════

# Base URL for the Express REST API backend
# In production, set to your backend deployment URL (e.g., https://api.yourdomain.com/api)
VITE_API_URL=/api

# Toggle client-side mock store (set to false for production live backend API)
VITE_USE_MOCK=false
